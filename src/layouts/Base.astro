---
import '../styles/global.css';
import { SITE, AUTHOR } from '../data/site';
import fontManifest from '../generated/font-manifest.json';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}

const { title, description, ogType = 'website', ogImage, jsonLd, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const image = new URL(ogImage ?? '/og/default.png', SITE.url).href;
const navigation = [
  { href: '/', label: '文章' },
  { href: '/topics/', label: '主题' },
  { href: '/about/', label: '关于' },
  { href: '/rss.xml', label: 'RSS' },
];
const { pathname } = Astro.url;
function current(href: string) {
  if (href === pathname) return 'page';
  if (href === '/' && pathname.startsWith('/posts/')) return 'location';
  if (href === '/topics/' && pathname.startsWith(href)) return 'location';
}
const fonts = fontManifest.files.map(({ url, hash, weight }) => ({ href: `${url}?v=${hash}`, weight }));
const fontRules = fonts.map(({ href, weight }) => `
  @font-face {
    font-family: "Blog Serif SC";
    src: url("${href}") format("woff2");
    font-style: normal;
    font-weight: ${weight};
    font-display: swap;
    unicode-range: U+201C-201D, U+2026, U+2E80-2EFF, U+3000-303F, U+3400-4DBF, U+4E00-9FFF, U+F900-FAFF, U+FE30-FE4F, U+FF00-FFEF;
  }`).join('\n');
const cfToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bingVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;
const baiduVerification = import.meta.env.PUBLIC_BAIDU_SITE_VERIFICATION;
---
<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    {bingVerification && <meta name="msvalidate.01" content={bingVerification} />}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {fonts.map(({ href }) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin="anonymous" />)}
    <style is:inline set:html={fontRules} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    {baiduVerification && <meta name="baidu-site-verification" content={baiduVerification} />}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <header class="nav">
      <div class="nav-bar">
        <a class="name" href="/">{SITE.shortTitle}</a>
        <nav class="nav-links" aria-label="主导航">
          {navigation.map(({ href, label }) => <a href={href} aria-current={current(href)}>{label}</a>)}
        </nav>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-about">
          <a class="footer-name" href="/">{SITE.shortTitle}</a>
          <p>读 AI Agent 源码、做实验和做项目时的记录。</p>
        </div>
        <nav aria-label="页脚导航">
          <div><h2>站内</h2>{navigation.map(({ href, label }) => <a href={href}>{label}</a>)}</div>
          <div><h2>联系</h2><a href={AUTHOR.github}>GitHub</a><a href={AUTHOR.x}>X</a></div>
        </nav>
      </div>
    </footer>
    {
      cfToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: cfToken })}
        />
      )
    }
  </body>
</html>
