            inside: '触发 <code>/in-your-own-words</code> + 匹配 <code>bug-fix</code> 剧本，把 6 个标准步骤原样写入 TodoList。',
            output: 'Agent 先压噪复述：问题出在幂等键或重试时序，而不是盲目跟着你的猜测改某个函数。你在它写第一行代码前就确认了方向没歪。',
          },
          {
            title: 'Step 2 · 摸清前世今生：读代码 + 查历史',
            prompt: '（剧本自动执行，无需你手动敲命令）',
            inside: '并发调 <code>/how</code> 追踪通知发送链路，同时调 <code>/why</code> 查 Git 历史和旧 PR，确认当初为什么没加去重、有没有历史兼容包袱。',
            output: '一份带代码路径和历史提交引用的简报。先在真实环境跑出一个<strong>稳定复现重复通知的失败样例</strong>。',
          },
          {
            title: 'Step 3 · 二分根因 & 定数据结构',
            prompt: '（若涉及跨模块接口调整，自动进入架构草图）',
            inside: '按 <code>Fix Root Causes</code> 原则用运行时日志二分排除假说；跨函数边界时走 <code>/architect</code>，用强类型把“已发送/未发送”状态显式建模，而不是顺手加个 <code>if (seen)</code> 补丁。',
            output: '每一行改动都能追溯到运行时证据；被证伪的猜想代码立刻回滚，不留半点多余防御。',
          },
          {
            title: 'Step 4 · 双重实证验收（重头戏）',
            prompt: '（触发 Prove It Works + 形式化状态检查）',
            inside: '① 运行时实证：在原复现表面重跑真实重试流程，拿到确凿日志/输出；② 形式化验证：用 <code>/create-formal-verification-skill</code> + <code>/statechart</code> 对“重试 + 并发通知”状态机跑 TLC 模型检查。',
            output: '交付物不是一句“我修好了”，而是：① 先红后绿的复现提交记录；② 真实运行证据；③ 一张确认无重复投递路径的状态图。',
          },
          {
            title: 'Step 5 · 清理、窄 PR 与防复发',
            prompt: '（收尾自动触发 /no-comments 与 opening-a-pr）',
            inside: '<code>Comment Sicko</code> 扫掉多余注释；按“先失败复现、后根因修复”的顺序整理小颗粒 Commit 打开窄 PR；如果同类幂等错以前也犯过，跑 <code>/correct</code> 补一条静态检查。',
            output: '一个自证清白、审阅极快的窄 PR，加上一条让未来所有 Agent 永久免疫同类 Bug 的护栏。',
          },
        ],
        feature: [
          {
            title: 'Step 1 · 召回记忆 + 明确终局目标',
            prompt: '/recall 我过去 7 天修列表闪烁和性能的记录。目标：设计一个从根源消灭闪烁的新虚拟化引擎，不要先写长篇 Plan。',
            inside: '触发 <code>/recall</code> 捞回近期上下文，结合 <code>feature</code> 剧本，跳过空洞的纸面计划。',
            output: 'Agent 带着过去 7 天的踩坑记忆进入状态，零重复解释。',
          },
          {
            title: 'Step 2 · 摸透旧实现与设计权衡',
            prompt: '用 /how 和 /why 摸清当前虚拟列表为什么会抖动。',
            inside: '<code>/how</code> 梳理测量、滚动与回收机制；<code>/why</code> 查清老架构妥协的历史原因。',
            output: '定位到核心矛盾（例如异步测量与同步渲染帧打架），避免新引擎重蹈覆辙。',
          },
          {
            title: 'Step 3 · README 驱动 + 多原型竞技',
            prompt: '先用 /technical-writing 写一篇“开发者怎么用这个新包”的教程；拿不准的滚动方案用原型剧本做 2 个可跑变体对比。',
            inside: '用教程倒推极简调用方 API；<code>/architect</code> + <code>/arena</code> 跨模型画接口草图；<code>prototype</code> 剧本挂出切换器跑真实帧率。',
            output: '不是猜哪个方案好，而是直接看两套原型的实测布局与耗时；再用 <code>/teach</code> 让 AI 讲透为什么新方案更优。',
          },
          {
            title: 'Step 4 · 真机跑通 + 数学证明 + 指标审计',
            prompt: '（自动调用验证技能、Lean 证明与 /benchmark-checklist）',
            inside: '① 用项目的验证 CLI + Feature Map 驱动真实 UI 录屏；② 对核心虚拟化索引算法用 Lean 证明不会出现越界抖动；③ 用 <code>/benchmark-checklist</code> 核验性能提速数字不是测偏了。',
            output: '端到端录屏 + 算法属性证明 + 经得起拷问的性能对比表。',
          },
          {
            title: 'Step 5 · 删旧留新，不留兼容垃圾',
            prompt: '（遵循 Migrate Callers Then Delete Legacy APIs）',
            inside: '按小步可验证单元（<code>Sequence Verifiable Units</code>）分批迁移调用方并直接删掉老实现；<code>/no-comments</code> 清理注释；若项目留了临时大计划文件，完工后直接删除免得误导后来的 Agent。',
            output: '干净的新底座上线，老旧实现清零，代码库反而比改造前更轻。',
          },
        ],
      };

      const SHOWCASE = {
        tibo: {
          title: 'tibo.dog —— 4 天业余时间、约 1,150 个 PR 做出 2.5D 像素生存游戏',
          intro: '2026 年 11 月 1 日发布，花 5.99 美元买域名，用 Grok Bot + Cursor + pstack 搭建，可直接嵌在 X 信息流卡片（245px）到全屏 60fps 运行。',
          items: [
            ['文件路径即性能契约（.hot.ts）', '凡是每帧 / 每 Tick 执行的热路径统一命名为 .hot.ts，配套 Lint 严禁在里面分配堆内存（禁止对象字面量、闭包、new），从根源杜绝 GC 掉帧。'],
            ['每抓一个 Bug 就加一条 Lint', '1,150 个 PR 没乱套的秘诀：发现坏模式立刻让 Bot 写一条拦截规则；代码注释被 Lint 全面禁止，写不清就改变量名或写测试。'],
            ['TLA+ 状态机护航', '剧情、过场演出、升级自动选卡与暂停/失焦组合全用 TLA+ 建模并用 /statechart 可视化，揪出了多个肉眼极难发现的状态竞争 Bug。'],
            ['硬预算与全代码化闭环', '首包超过 124KB gzipped 直接构建失败；没有外部音频和图片文件，音乐由自研 Game Boy 芯片代码合成、像素画全由代码生成；模拟 100% 确定性（服务端重放校验高分），甚至让 Headless Bot 自动打游戏调难度生存率。'],
          ],
        },
        dune: {
          title: 'Dune & Grok Bot —— 团队月合入 11,000 PR，回滚率稳在约 0.5%',
          intro: 'SpaceXSI 内部构建的桌面客户端框架（类似 Electron 版 Next.js），把多年做桌面应用的血泪教训全部编码成框架硬约束。',
          items: [
            ['业务代码直接禁掉 useEffect', '凡是需要“极高微妙直觉”才能用对的 API，Agent 必然用成垃圾。团队干脆在业务层彻底禁用 useEffect，只允许在框架封装好的原语内部使用。'],
            ['目录名 + 依赖分析硬隔离进程', '吸取 Cursor 时期渲染层误引主进程导致卡顿的教训，直接设 electron-main 与 electron-renderer 顶层目录，由依赖图 Lint 物理封死跨界导入。'],
            ['报错信息自带“修复指南”', 'Lint 报错不只是冷冰冰地红灯拒绝，而是明确指路该换哪个文件、哪个函数去治根因，让 Agent 一轮就能自动修对。'],
            ['外环自动 Fuzz 找虫并自动合入', '正因为内环足够硬，每发一个新版本，Grok Bot 都会自动起项目像真人一样乱点整个应用找 Bug、开修复 PR 并走完验证自动合并，性能反而越迭代越快。'],
          ],
        },
      };

      let currentChapter = 0;
      let currentSkillGroup = '摸底对齐';
      let currentWalkCase = 'bug';
      let currentWalkStep = 0;

      const tabs = Array.from(document.querySelectorAll('.pg-tab'));
      const panels = Array.from(document.querySelectorAll('.pg-panel'));
      const prevBtn = document.getElementById('pgPrevBtn');
      const nextBtn = document.getElementById('pgNextBtn');
      const progressText = document.getElementById('pgProgressText');
      const progressFill = document.getElementById('pgProgressFill');
      const pagerHint = document.getElementById('pgPagerHint');
      const pillMacro = document.getElementById('pg-pill-macro');
      const pillMeso = document.getElementById('pg-pill-meso');
      const pillMicro = document.getElementById('pg-pill-micro');

      function setChapter(idx, shouldScroll) {
        currentChapter = Math.max(0, Math.min(5, idx));
        tabs.forEach((btn, i) => btn.setAttribute('aria-selected', i === currentChapter ? 'true' : 'false'));
        panels.forEach((el, i) => el.classList.toggle('is-active', i === currentChapter));

        const pct = ((currentChapter + 1) / 6) * 100;
        progressText.textContent = '第 ' + (currentChapter + 1) + ' / 6 章';
        progressFill.style.width = pct + '%';

        const level = panels[currentChapter].getAttribute('data-level');
        pillMacro.classList.toggle('active', level === 'macro');
        pillMeso.classList.toggle('active', level === 'meso');
        pillMicro.classList.toggle('active', level === 'micro');

        prevBtn.disabled = currentChapter === 0;
        prevBtn.textContent = currentChapter > 0 ? '← ' + CHAPTER_TITLES[currentChapter - 1].split('：')[0] : '← 已是开篇';
        nextBtn.textContent = currentChapter === 5 ? '回到第 01 章 ↺' : '下一章：' + CHAPTER_TITLES[currentChapter + 1].split('：')[0] + ' →';
        pagerHint.textContent = CHAPTER_TITLES[currentChapter];
        if (shouldScroll) window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      tabs.forEach((btn) => btn.addEventListener('click', () => setChapter(Number(btn.dataset.chapter), true)));
      prevBtn.addEventListener('click', () => setChapter(currentChapter - 1, true));
      nextBtn.addEventListener('click', () => setChapter(currentChapter === 5 ? 0 : currentChapter + 1, true));

      const themeToggle = document.getElementById('pgThemeToggle');
      function isDarkNow() {
        const attr = document.documentElement.getAttribute('data-theme');
        if (attr === 'dark') return true;
        if (attr === 'light') return false;
        return window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
      }
      function syncThemeBtn() {
        themeToggle.textContent = isDarkNow() ? '切暖纸' : '切夜纸';
      }
      themeToggle.addEventListener('click', () => {
        document.documentElement.setAttribute('data-theme', isDarkNow() ? 'light' : 'dark');
        syncThemeBtn();
      });
      syncThemeBtn();

      document.querySelectorAll('.pg-paradox-trigger').forEach((btn) => {
        btn.addEventListener('click', () => {
          const item = btn.closest('.pg-paradox-item');
          const open = item.classList.toggle('is-open');
          btn.setAttribute('aria-expanded', open ? 'true' : 'false');
          btn.querySelector('.pg-badge').textContent = open ? '点击收起' : '点击展开';
        });
      });

      const pyramidDetail = document.getElementById('pgPyramidDetail');
      function renderPyramid(tier) {
        const d = PYRAMID_DATA[tier];
        document.querySelectorAll('.pg-pyr-tier').forEach((b) => b.classList.toggle('is-active', b.dataset.tier === tier));
        pyramidDetail.innerHTML =
          '<div class="pg-eyebrow" style="margin-bottom:6px;">' + d.badge + '</div>' +
          '<h3 style="font-size:21px;margin-bottom:10px;">' + d.title + '</h3>' +
          '<p><strong>核心逻辑：</strong>' + d.why + '</p>' +
          '<p><strong>真实落地例子：</strong>' + d.example + '</p>' +
          '<p style="font-size:15px;color:var(--brand);margin-top:8px;margin-bottom:0;">' + d.pstack + '</p>';
      }
      document.querySelectorAll('.pg-pyr-tier').forEach((b) => b.addEventListener('click', () => renderPyramid(b.dataset.tier)));
      renderPyramid('1');

      const scenarioBox = document.getElementById('pgScenarioBox');
      function renderScenario(key) {
        const s = SCENARIO_DATA[key];
        document.querySelectorAll('#pgScenarioBtns .pg-seg-btn').forEach((b) => b.classList.toggle('is-active', b.dataset.scene === key));
        const stepsHtml = s.steps.map((item) => '<li style="margin:6px 0;"><strong>' + item[0] + '：</strong>' + item[1] + '</li>').join('');
        scenarioBox.innerHTML =
          '<div class="pg-split" style="margin-top:0;">' +
            '<div class="pg-box"><span class="pg-box-label">普通做法（留在倒金字塔底层）</span><p style="margin:0;">' + s.bad + '</p></div>' +
            '<div class="pg-box is-good"><span class="pg-box-label">土豆姐做法（沿倒金字塔往上焊死）</span><ul style="margin:0;padding-left:1.2em;">' + stepsHtml + '</ul></div>' +
          '</div>';
      }
      document.querySelectorAll('#pgScenarioBtns .pg-seg-btn').forEach((b) => b.addEventListener('click', () => renderScenario(b.dataset.scene)));
      renderScenario('timer');

      const archDetail = document.getElementById('pgArchDetail');
      function renderArch(layerIdx) {
        const data = ARCH_DATA[layerIdx];
        document.querySelectorAll('.pg-arch-layer').forEach((b) => b.classList.toggle('is-active', Number(b.dataset.layer) === layerIdx));
        let html = '<h3 style="font-size:21px;margin-bottom:8px;">' + data.title + '</h3>';
        html += '<p style="color:var(--olive);">' + data.summary + '</p>';
        if (data.bullets) {
          html += '<ul>' + data.bullets.map((t) => '<li style="margin:8px 0;">' + t + '</li>').join('') + '</ul>';
        }
        if (data.groups) {
          const groupNames = Object.keys(data.groups);
          html += '<div class="pg-seg-row" id="pgSkillGroupTabs">' + groupNames.map((g) =>
            '<button class="pg-seg-btn' + (g === currentSkillGroup ? ' is-active' : '') + '" type="button" data-group="' + g + '">' + g + '</button>'
          ).join('') + '</div>';
          const cards = data.groups[currentSkillGroup].map((pair) =>
            '<div class="pg-skill-card"><div style="margin-bottom:6px;"><code>' + pair[0] + '</code></div><div class="pg-skill-desc">' + pair[1] + '</div></div>'
          ).join('');
          html += '<div class="pg-skill-grid">' + cards + '</div>';
          html += '<p style="margin-top:14px;margin-bottom:0;font-size:15px;color:var(--olive);">' + data.agentsNote + '</p>';
        }
        if (data.principles) {
          html += '<div class="pg-paradox-list">' + data.principles.map((p) =>
            '<div class="pg-skill-card"><strong style="display:block;margin-bottom:4px;color:var(--brand);">' + p[0] + '</strong><span class="pg-skill-desc">' + p[1] + '</span></div>'
          ).join('') + '</div>';
        }
        archDetail.innerHTML = html;
        archDetail.querySelectorAll('#pgSkillGroupTabs .pg-seg-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            currentSkillGroup = btn.dataset.group;
            renderArch(2);
          });
        });
      }
      document.querySelectorAll('.pg-arch-layer').forEach((b) => b.addEventListener('click', () => renderArch(Number(b.dataset.layer))));
      renderArch(0);

      const walkthroughDetail = document.getElementById('pgWalkthroughDetail');
      function renderWalkthrough() {
        const item = WALKTHROUGH[currentWalkCase][currentWalkStep];
        document.querySelectorAll('#pgCaseToggle .pg-seg-btn').forEach((b) => b.classList.toggle('is-active', b.dataset.case === currentWalkCase));
        document.querySelectorAll('#pgStepper .pg-step-btn').forEach((b) => b.classList.toggle('is-active', Number(b.dataset.step) === currentWalkStep));
        walkthroughDetail.innerHTML =
          '<h3 style="font-size:21px;margin-bottom:10px;">' + item.title + '</h3>' +
          '<div style="font-size:14px;color:var(--stone);margin-bottom:4px;">人类给的提示词 / 动作</div>' +
          '<pre><code>' + item.prompt + '</code></pre>' +
          '<div class="pg-split">' +
            '<div class="pg-box"><span class="pg-box-label">pstack 内部发生了什么</span><p style="margin:0;">' + item.inside + '</p></div>' +
            '<div class="pg-box is-good"><span class="pg-box-label">这一步交付的硬结果</span><p style="margin:0;">' + item.output + '</p></div>' +
          '</div>';
      }
      document.querySelectorAll('#pgCaseToggle .pg-seg-btn').forEach((b) => b.addEventListener('click', () => {
        currentWalkCase = b.dataset.case;
        renderWalkthrough();
      }));
      document.querySelectorAll('#pgStepper .pg-step-btn').forEach((b) => b.addEventListener('click', () => {
        currentWalkStep = Number(b.dataset.step);
        renderWalkthrough();
      }));
      renderWalkthrough();

      const showcaseBox = document.getElementById('pgShowcaseBox');
      function renderShowcase(key) {
        const d = SHOWCASE[key];
        document.querySelectorAll('#pgShowcaseBtns .pg-seg-btn').forEach((b) => b.classList.toggle('is-active', b.dataset.case === key));
        const grid = d.items.map((pair) =>
          '<div class="pg-skill-card"><strong style="display:block;margin-bottom:6px;color:var(--near-black);">' + pair[0] + '</strong><span class="pg-skill-desc">' + pair[1] + '</span></div>'
        ).join('');
        showcaseBox.innerHTML =
          '<h3 style="font-size:21px;margin-bottom:6px;">' + d.title + '</h3>' +
          '<p style="color:var(--olive);font-size:15px;">' + d.intro + '</p>' +
          '<div class="pg-skill-grid">' + grid + '</div>';
      }
      document.querySelectorAll('#pgShowcaseBtns .pg-seg-btn').forEach((b) => b.addEventListener('click', () => renderShowcase(b.dataset.case)));
      renderShowcase('tibo');

      const STORAGE_KEY = 'sunsky-pstack-guide-checklist-v1';
      const checkboxes = Array.from(document.querySelectorAll('.pstack-guide input[type="checkbox"][data-check]'));
      const scoreLabel = document.getElementById('pgScoreLabel');
      const scoreFill = document.getElementById('pgScoreFill');
      const scoreAdvice = document.getElementById('pgScoreAdvice');

      function updateScore() {
        const total = checkboxes.length;
        const done = checkboxes.filter((cb) => cb.checked).length;
        const pct = Math.round((done / total) * 100);
        scoreFill.style.width = pct + '%';
        let stageText = '刚起步';
        let advice = '先拿下第 1 阶段的 3 个习惯，不用改一行配置，今天就能把 AI 返工率打下来一半。';
        if (done >= 3 && done < 6) {
          stageText = '协作已顺手 · 准备建护栏';
          advice = '你的提问方式已经到位，下一步把精力放到第 2 阶段：统一验证命令 + 功能地图 + 2 条高价值 Lint。';
        } else if (done >= 6 && done < 9) {
          stageText = '高信任内环成型';
          advice = '你已经跑赢绝大多数 AI 编程团队了。接下来可以在关键状态机或并发模块试水形式化验证与多路并行。';
        } else if (done === 9) {
          stageText = '软件工厂就绪';
          advice = '内环扎实、证据闭环，你已经具备让多 Agent 放心并行甚至过夜交付的基础设施。';
        }
        scoreLabel.textContent = '已完成 ' + done + ' / ' + total + ' 项 · ' + stageText;
        scoreAdvice.textContent = advice;
      }

      try {
        const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
        checkboxes.forEach((cb) => {
          cb.checked = Boolean(saved[cb.dataset.check]);
          cb.closest('.pg-check-item').classList.toggle('is-done', cb.checked);
        });
      } catch (e) {}
      updateScore();

      checkboxes.forEach((cb) => {
        cb.addEventListener('change', () => {
          const state = {};
          checkboxes.forEach((item) => {
            state[item.dataset.check] = item.checked;
            item.closest('.pg-check-item').classList.toggle('is-done', item.checked);
          });
          try {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
          } catch (e) {}
          updateScore();
        });
      });
    })();
  </script>
</Base>
