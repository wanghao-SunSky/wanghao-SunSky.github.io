      function setChapter(idx, shouldScroll) {
        currentChapter = Math.max(0, Math.min(5, idx));
        tabs.forEach((btn, i) => btn.setAttribute('aria-selected', i === currentChapter ? 'true' : 'false'));
        panels.forEach((el, i) => el.classList.toggle('is-active', i === currentChapter));

        const pct = ((currentChapter + 1) / 6) * 100;
        progressText.textContent = '第 ' + (currentChapter + 1) + ' / 6 章';
        progressFill.style.width = pct + '%';

        const level = panels[currentChapter].getAttribute('data-level');
        pillMacro.classList.toggle('active', level === 'macro');
        pillMeso.classList.toggle('active', level === 'meso');
        pillMicro.classList.toggle('active', level === 'micro');

        prevBtn.disabled = currentChapter === 0;
        prevBtn.textContent = currentChapter > 0 ? '← ' + CHAPTER_TITLES[currentChapter - 1].split('：')[0] : '← 已是开篇';
        nextBtn.textContent = currentChapter === 5 ? '回到第 01 章 ↺' : '下一章：' + CHAPTER_TITLES[currentChapter + 1].split('：')[0] + ' →';
        pagerHint.textContent = CHAPTER_TITLES[currentChapter];
        if (typeof hidePopover === 'function') hidePopover();
        if (shouldScroll) window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      tabs.forEach((btn) => btn.addEventListener('click', () => setChapter(Number(btn.dataset.chapter), true)));
      prevBtn.addEventListener('click', () => setChapter(currentChapter - 1, true));
      nextBtn.addEventListener('click', () => setChapter(currentChapter === 5 ? 0 : currentChapter + 1, true));

      const themeToggle = document.getElementById('pgThemeToggle');
      function isDarkNow() {
        const attr = document.documentElement.getAttribute('data-theme');
        if (attr === 'dark') return true;
        if (attr === 'light') return false;
        return window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
      }
      function syncThemeBtn() {
        themeToggle.textContent = isDarkNow() ? '切暖纸' : '切夜纸';
      }
      themeToggle.addEventListener('click', () => {
        document.documentElement.setAttribute('data-theme', isDarkNow() ? 'light' : 'dark');
        syncThemeBtn();
      });
      syncThemeBtn();

