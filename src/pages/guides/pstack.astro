      const TERM_KEYS = Object.keys(GLOSSARY).sort((a, b) => b.length - a.length);
      const TERM_REGEX = new RegExp(
        '(' +
          TERM_KEYS.map((k) => {
            const esc = k.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
            const pre = /^[A-Za-z]/.test(k) ? '(?<![A-Za-z0-9_-])' : '';
            const suf = /[A-Za-z]$/.test(k) ? '(?![A-Za-z0-9_-])' : '';
            return pre + esc + suf;
          }).join('|') +
          ')',
        'g'
      );
      const SKIP_TAGS = new Set(['CODE', 'PRE', 'A', 'BUTTON', 'H1', 'SCRIPT', 'STYLE', 'TEXTAREA', 'INPUT']);

      function annotateTerms(root) {
        if (!root) return;
        const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
        const nodes = [];
        let node;
        while ((node = walker.nextNode())) {
          if (!node.nodeValue || !TERM_REGEX.test(node.nodeValue)) continue;
          TERM_REGEX.lastIndex = 0;
          let p = node.parentElement;
          let skip = false;
          while (p && p !== root) {
            if (SKIP_TAGS.has(p.tagName) || p.classList.contains('pg-term')) {
              skip = true;
              break;
            }
            p = p.parentElement;
          }
          if (!skip) nodes.push(node);
        }
        nodes.forEach((textNode) => {
          const text = textNode.nodeValue;
          TERM_REGEX.lastIndex = 0;
          const frag = document.createDocumentFragment();
          let last = 0;
          let match;
          while ((match = TERM_REGEX.exec(text))) {
            const idx = match.index;
            const term = match[0];
            if (idx > last) frag.appendChild(document.createTextNode(text.slice(last, idx)));
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'pg-term';
            btn.dataset.term = term;
            btn.textContent = term;
            frag.appendChild(btn);
            last = idx + term.length;
          }
          if (last < text.length) frag.appendChild(document.createTextNode(text.slice(last)));
          textNode.parentNode.replaceChild(frag, textNode);
        });
      }

      const popover = document.getElementById('pgPopover');
      const popTag = document.getElementById('pgPopTag');
      const popTitle = document.getElementById('pgPopTitle');
      const popPlain = document.getElementById('pgPopPlain');
      const popAnalog = document.getElementById('pgPopAnalog');
      const popClose = document.getElementById('pgPopClose');
      let activeTermEl = null;
      let hideTimer = null;

      function hidePopover() {
        clearTimeout(hideTimer);
        popover.classList.remove('is-visible');
        popover.setAttribute('aria-hidden', 'true');
        if (activeTermEl) {
          activeTermEl.classList.remove('is-open');
          activeTermEl = null;
        }
      }

      function showPopover(target) {
        clearTimeout(hideTimer);
        const key = target.dataset.term;
        const entry = GLOSSARY[key];
        if (!entry) return;
        if (activeTermEl && activeTermEl !== target) activeTermEl.classList.remove('is-open');
        activeTermEl = target;
        activeTermEl.classList.add('is-open');

        popTag.textContent = entry.tag;
        popTitle.textContent = entry.title;
        popPlain.textContent = entry.plain;
        popAnalog.textContent = entry.analog;

        popover.classList.add('is-visible');
        popover.setAttribute('aria-hidden', 'false');

        const rect = target.getBoundingClientRect();
        const popW = popover.offsetWidth || 320;
        const popH = popover.offsetHeight || 160;
        let left = rect.left + rect.width / 2 - popW / 2;
        left = Math.max(12, Math.min(window.innerWidth - popW - 12, left));
        let top = rect.bottom + 8;
        if (top + popH > window.innerHeight - 12) {
          top = Math.max(12, rect.top - popH - 8);
        }
        popover.style.left = Math.round(left) + 'px';
        popover.style.top = Math.round(top) + 'px';
      }

      const stageEl = document.querySelector('.pg-stage');
      stageEl.addEventListener('click', (e) => {
        const termBtn = e.target.closest('.pg-term');
        if (termBtn) {
          e.stopPropagation();
          if (activeTermEl === termBtn && popover.classList.contains('is-visible')) {
            hidePopover();
          } else {
            showPopover(termBtn);
          }
        }
      });
      stageEl.addEventListener('mouseover', (e) => {
        const termBtn = e.target.closest('.pg-term');
        if (termBtn) showPopover(termBtn);
      });
      stageEl.addEventListener('mouseout', (e) => {
        const termBtn = e.target.closest('.pg-term');
        if (termBtn) {
          hideTimer = setTimeout(() => {
            if (!popover.matches(':hover')) hidePopover();
          }, 180);
        }
      });
      popover.addEventListener('mouseenter', () => clearTimeout(hideTimer));
      popover.addEventListener('mouseleave', () => {
        hideTimer = setTimeout(hidePopover, 160);
      });
      popClose.addEventListener('click', hidePopover);
      document.addEventListener('click', (e) => {
        if (!popover.contains(e.target) && !e.target.closest('.pg-term')) hidePopover();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') hidePopover();
      });

      const pyramidDetail = document.getElementById('pgPyramidDetail');
      function renderPyramid(tier) {
        const d = PYRAMID_DATA[tier];
        document.querySelectorAll('.pg-pyr-tier').forEach((b) => b.classList.toggle('is-active', b.dataset.tier === tier));
        pyramidDetail.innerHTML =
          '<div class="pg-eyebrow" style="margin-bottom:6px;">' + d.badge + '</div>' +
          '<h3 style="font-size:21px;margin-bottom:10px;">' + d.title + '</h3>' +
          '<p><strong>设计逻辑：</strong>' + d.why + '</p>' +
          '<p><strong>工程实例：</strong>' + d.example + '</p>' +
          '<p style="font-size:15px;color:var(--brand);margin-top:8px;margin-bottom:0;">' + d.pstack + '</p>';
        annotateTerms(pyramidDetail);
      }
      document.querySelectorAll('.pg-pyr-tier').forEach((b) => b.addEventListener('click', () => renderPyramid(b.dataset.tier)));
      renderPyramid('1');

      const scenarioBox = document.getElementById('pgScenarioBox');
      function renderScenario(key) {
        const s = SCENARIO_DATA[key];
        document.querySelectorAll('#pgScenarioBtns .pg-seg-btn').forEach((b) => b.classList.toggle('is-active', b.dataset.scene === key));
        const stepsHtml = s.steps.map((item) => '<li style="margin:6px 0;"><strong>' + item[0] + '：</strong>' + item[1] + '</li>').join('');
        scenarioBox.innerHTML =
          '<div class="pg-split" style="margin-top:0;">' +
            '<div class="pg-box"><span class="pg-box-label">常见做法（停留在文档软约束）</span><p style="margin:0;">' + s.bad + '</p></div>' +
            '<div class="pg-box is-good"><span class="pg-box-label">pstack 做法（沿倒金字塔向上升级）</span><ul style="margin:0;padding-left:1.2em;">' + stepsHtml + '</ul></div>' +
          '</div>';
        annotateTerms(scenarioBox);
      }
      document.querySelectorAll('#pgScenarioBtns .pg-seg-btn').forEach((b) => b.addEventListener('click', () => renderScenario(b.dataset.scene)));
      renderScenario('timer');

      const archDetail = document.getElementById('pgArchDetail');
      function renderArch(layerIdx) {
        const data = ARCH_DATA[layerIdx];
        document.querySelectorAll('.pg-arch-layer').forEach((b) => b.classList.toggle('is-active', Number(b.dataset.layer) === layerIdx));
        let html = '<h3 style="font-size:21px;margin-bottom:8px;">' + data.title + '</h3>';
        html += '<p style="color:var(--olive);">' + data.summary + '</p>';
        if (data.bullets) {
          html += '<ul>' + data.bullets.map((t) => '<li style="margin:8px 0;">' + t + '</li>').join('') + '</ul>';
        }
        if (data.groups) {
          const groupNames = Object.keys(data.groups);
          html += '<div class="pg-seg-row" id="pgSkillGroupTabs">' + groupNames.map((g) =>
            '<button class="pg-seg-btn' + (g === currentSkillGroup ? ' is-active' : '') + '" type="button" data-group="' + g + '">' + g + '</button>'
          ).join('') + '</div>';
          const cards = data.groups[currentSkillGroup].map((pair) =>
            '<div class="pg-skill-card"><div style="margin-bottom:6px;"><code>' + pair[0] + '</code></div><div class="pg-skill-desc">' + pair[1] + '</div></div>'
          ).join('');
          html += '<div class="pg-skill-grid">' + cards + '</div>';
          html += '<p style="margin-top:14px;margin-bottom:0;font-size:15px;color:var(--olive);">' + data.agentsNote + '</p>';
        }
        if (data.principles) {
          html += '<div class="pg-paradox-list">' + data.principles.map((p) =>
            '<div class="pg-skill-card"><strong style="display:block;margin-bottom:4px;color:var(--brand);">' + p[0] + '</strong><span class="pg-skill-desc">' + p[1] + '</span></div>'
          ).join('') + '</div>';
        }
        archDetail.innerHTML = html;
        annotateTerms(archDetail);
        archDetail.querySelectorAll('#pgSkillGroupTabs .pg-seg-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            currentSkillGroup = btn.dataset.group;
            renderArch(2);
          });
        });
      }
      document.querySelectorAll('.pg-arch-layer').forEach((b) => b.addEventListener('click', () => renderArch(Number(b.dataset.layer))));
      renderArch(0);

      const walkthroughDetail = document.getElementById('pgWalkthroughDetail');
      function renderWalkthrough() {
        const item = WALKTHROUGH[currentWalkCase][currentWalkStep];
        document.querySelectorAll('#pgCaseToggle .pg-seg-btn').forEach((b) => b.classList.toggle('is-active', b.dataset.case === currentWalkCase));
        document.querySelectorAll('#pgStepper .pg-step-btn').forEach((b) => b.classList.toggle('is-active', Number(b.dataset.step) === currentWalkStep));
        walkthroughDetail.innerHTML =
          '<h3 style="font-size:21px;margin-bottom:10px;">' + item.title + '</h3>' +
          '<div style="font-size:14px;color:var(--stone);margin-bottom:4px;">开发者输入的指令 / 触发条件</div>' +
          '<pre><code>' + item.prompt + '</code></pre>' +
          '<div class="pg-split">' +
            '<div class="pg-box"><span class="pg-box-label">pstack 内部调度动作</span><p style="margin:0;">' + item.inside + '</p></div>' +
            '<div class="pg-box is-good"><span class="pg-box-label">当前阶段交付产物</span><p style="margin:0;">' + item.output + '</p></div>' +
          '</div>';
        annotateTerms(walkthroughDetail);
      }
      document.querySelectorAll('#pgCaseToggle .pg-seg-btn').forEach((b) => b.addEventListener('click', () => {
        currentWalkCase = b.dataset.case;
        renderWalkthrough();
      }));
      document.querySelectorAll('#pgStepper .pg-step-btn').forEach((b) => b.addEventListener('click', () => {
        currentWalkStep = Number(b.dataset.step);
        renderWalkthrough();
      }));
      renderWalkthrough();

      const showcaseBox = document.getElementById('pgShowcaseBox');
      function renderShowcase(key) {
        const d = SHOWCASE[key];
        document.querySelectorAll('#pgShowcaseBtns .pg-seg-btn').forEach((b) => b.classList.toggle('is-active', b.dataset.case === key));
        const grid = d.items.map((pair) =>
          '<div class="pg-skill-card"><strong style="display:block;margin-bottom:6px;color:var(--near-black);">' + pair[0] + '</strong><span class="pg-skill-desc">' + pair[1] + '</span></div>'
        ).join('');
        showcaseBox.innerHTML =
          '<h3 style="font-size:21px;margin-bottom:6px;">' + d.title + '</h3>' +
          '<p style="color:var(--olive);font-size:15px;">' + d.intro + '</p>' +
          '<div class="pg-skill-grid">' + grid + '</div>';
        annotateTerms(showcaseBox);
      }
      document.querySelectorAll('#pgShowcaseBtns .pg-seg-btn').forEach((b) => b.addEventListener('click', () => renderShowcase(b.dataset.case)));
      renderShowcase('tibo');

      annotateTerms(stageEl);

      const STORAGE_KEY = 'sunsky-pstack-guide-checklist-v1';
      const checkboxes = Array.from(document.querySelectorAll('.pstack-guide input[type="checkbox"][data-check]'));
      const scoreLabel = document.getElementById('pgScoreLabel');
      const scoreFill = document.getElementById('pgScoreFill');
      const scoreAdvice = document.getElementById('pgScoreAdvice');

      function updateScore() {
        const total = checkboxes.length;
        const done = checkboxes.filter((cb) => cb.checked).length;
        const pct = Math.round((done / total) * 100);
        scoreFill.style.width = pct + '%';
        let stageText = '起步阶段';
        let advice = '建议先落地第 1 阶段的 3 项协作习惯，无需改动项目配置，即可显著降低因理解偏差导致的返工。';
        if (done >= 3 && done < 6) {
          stageText = '协作习惯已就绪 · 待补齐静态护栏';
          advice = '任务交接方式已建立，下一步建议推进第 2 阶段：收敛统一验证命令、编写核心路径 Feature Map，并落地 2–3 条带修复提示的 Lint。';
        } else if (done >= 6 && done < 9) {
          stageText = '单机高信任内环已成型';
          advice = '项目已具备扎实的内环拦截能力。接下来可在复杂状态机或高并发模块尝试形式化验证（TLA+ / 状态图）与独立 Worktree 多路并行。';
        } else if (done === 9) {
          stageText = '内环与外环全面就绪';
          advice = '静态约束与运行时实证均已到位，具备支撑多 Agent 并行交付与夜间自动化运行的基础设施。';
        }
        scoreLabel.textContent = '已完成 ' + done + ' / ' + total + ' 项 · ' + stageText;
        scoreAdvice.textContent = advice;
      }

      try {
        const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
        checkboxes.forEach((cb) => {
          cb.checked = Boolean(saved[cb.dataset.check]);
          cb.closest('.pg-check-item').classList.toggle('is-done', cb.checked);
        });
      } catch (e) {}
      updateScore();

      checkboxes.forEach((cb) => {
        cb.addEventListener('change', () => {
          const state = {};
          checkboxes.forEach((item) => {
            state[item.dataset.check] = item.checked;
            item.closest('.pg-check-item').classList.toggle('is-done', item.checked);
          });
          try {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
          } catch (e) {}
          updateScore();
        });
      });
    })();
  </script>
